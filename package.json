{
    "name": "cyclone_viewer",
    "version": "1.0.0",
    "description": "Cyclone Track Editor/Visualizer",
    "main": "electron-main.js",
    "scripts": {
        "start": "electron .",
        "serve": "http-server . -c-1 -p 5173",
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
        "debug": "electron --inspect=5858 .",
        "debug:brk": "electron --inspect-brk=5858 .",
    "package": "npm run build && electron-packager . CycloneTracker --platform=darwin,linux --arch=x64 --out=release-builds --overwrite",
    "package:mac": "npm run build && electron-packager . CycloneTracker --platform=darwin --arch=x64 --out=release-builds --overwrite",
    "package:win": "npm run build && ELECTRON_PACKAGER_WINE=\"$(which wine)\" electron-packager . CycloneTracker --platform=win32 --arch=x64 --out=release-builds --overwrite",
    "package:linux": "npm run build && electron-packager . CycloneTracker --platform=linux --arch=x64 --out=release-builds --overwrite",
        "package:all": "npm run package:mac && npm run package:linux && npm run package:win"
    },
    "dependencies": {},
    "devDependencies": {
        "electron": "^26.0.0",
        "electron-packager": "^17.1.2",
        "http-server": "^14.1.1",
        "@vitejs/plugin-legacy": "^5.0.0",
        "vite": "^5.0.0",
        "concurrently": "^8.0.0",
        "wait-on": "^7.0.0",
        "cross-env": "^7.0.3"
    }
        ,
        "engines": {
            "node": ">=18.0.0",
            "npm": ">=9.0.0"
        }
}
